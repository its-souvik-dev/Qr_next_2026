# PostgreSQL connection string
DATABASE_URL="postgresql://maxqr:maxqr@localhost:5432/maxqr?schema=public"

# Optional: connection pool size per server instance (default 10). Use 1 with `prisma dev`.
# DATABASE_POOL_MAX=10

# Public base URL of the app (used to build short links, e.g. https://yourdomain.com/s/abc123)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 32+ byte random secret. Used to key visitor hashing for privacy-conscious analytics.
# Generate with: openssl rand -hex 32
APP_SECRET=""

# Secret for the scheduled cleanup endpoint (POST /api/cron/cleanup with "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=""

# Optional: comma separated hostnames that serve the app (custom-domain routing ignores these)
# APP_HOSTNAMES="localhost,yourdomain.com"
